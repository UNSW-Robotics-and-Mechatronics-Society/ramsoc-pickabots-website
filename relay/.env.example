# ── Supabase (same project as the website) ─────────────────────────
# supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── OBS WebSocket (OBS → Tools → WebSocket Server Settings) ────────
# Default port is 4455; copy the password from that dialog.
# Either give the full URL, or OBS_WS_HOST/OBS_WS_PORT separately.
OBS_WS_URL=ws://127.0.0.1:4455
#OBS_WS_HOST=127.0.0.1
#OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# ── MediaMTX feed monitoring (optional) ────────────────────────────
# Control API of the MediaMTX instance on this PC (mediamtx.yml: api: yes).
# When set, the control panel shows live/offline lights for the remote-room
# RTMP feeds (room2/room3/phone). Leave empty to disable.
MEDIAMTX_API_URL=http://127.0.0.1:9997
